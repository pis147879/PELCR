Grammar

    0 $accept: lines $end

    1 lines: lines line
    2      | line

    3 line: lterm NL
    4     | stmt NL
    5     | error

    6 stmt: QUIT
    7     | SYMBOL
    8     | TRACEF
    9     | VERBOSEF
   10     | SETLOOPS NUM
   11     | SETFIRES NUM
   12     | WRITE PATH
   13     | USELIB PATH
   14     | XCALL '(' ID ')' '(' PATH ')'
   15     | XCALL '(' ID ')' '(' NUM ')'
   16     | DEF ID EQ lterm
   17     | SETDIR PATH
   18     | STATUS
   19     | HELP
   20     | GMLGRAPH

   21 lterm: LAMBDA ID '.' lterm
   22      | '(' lterm ')' lterm
   23      | '[' lterm OP1 lterm ']'
   24      | ID
   25      | NUM
   26      | BOOLEAN
   27      | F1ARG '(' lterm ')'
   28      | F2ARG '(' lterm ',' lterm ')'
   29      | XFUNCTION '(' ID ')' '(' lterm ')'
   30      | XFUNCTION '(' ID ')' '(' lterm ',' lterm ')'
   31      | IF lterm THEN lterm ELSE lterm
   32      | LET ID EQ lterm INN lterm
   33      | REC ID INN lterm


